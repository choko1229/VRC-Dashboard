# このファイルを .env にコピーして使う（.env自体はコミットしないこと。.gitignoreで除外済み）。
#
# Discord OAuthアプリの情報・VRChat APIの連絡先・Web PushのVAPID鍵など、
# 外部連携に必要な設定は初回起動後に表示される初期セットアップ画面
# （http://localhost:8000/setup）およびログイン後の「全般設定」画面から
# 入力・変更できる（DBに保存される）。.envで指定する必要はない。
#
# 通常はPORT以外、何も設定しなくてよい。

# ダッシュボードを公開するポート番号
PORT=8000

# --- 以下は上級者向けの任意設定（通常は不要） ---
# APP_ENV=development
# DEBUG=false
# DATABASE_URL=sqlite+aiosqlite:///./data/vrc_dashboard.db
# 秘密情報の暗号化鍵。未指定の場合はdata/fernet.keyに自動生成されるため通常は不要。
# FERNET_MASTER_KEY=
